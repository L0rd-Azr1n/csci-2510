<html>

<head>
    <title>Game Loop
    </title>
    <Style>
        *{
            margin:0;
            overflow: hidden;
        }
    </Style>
</head>

<body>
    <canvas id="canv">

    </canvas>
    <script src="Vector2.js"></script>
    <script>
        let canvas = document.querySelector("#canv")
        let ctx = canvas.getContext("2d")


        let position = new Vector2(50, 50)


        function gameLoop() {
            update()
            draw()
            requestAnimationFrame(gameLoop)
        }

        function update() {
            
        }

        function draw() {

            
        canvas.width = window.innerWidth
        canvas.Height = window.innerHeight
        //signal to context to draw smth
        ctx.save()

        //declare center
        ctx.translate(position.x, position.y)

        ctx.lineTo(0, -40)
        ctx.lineTo(-10, -20)
        ctx.lineTo(-25, -20)
        ctx.lineTo(-10, 2)
        ctx.lineTo(-15, 20)
        ctx.lineTo(0, 20)
        ctx.lineTo(15, 20)
        ctx.lineTo(10, 2)
        ctx.lineTo(25, -20)
        ctx.lineTo(10, -20)

        ctx.fillStyle = "cyan"
        ctx.fill()

        //signal finished
        ctx.restore()
        }

        requestAnimationFrame(gameLoop)
    </script>
</body>

</html>
